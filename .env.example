# === LLM Provider Configuration ===
# Supported: "openai", "anthropic", "google", "ollama"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# === API Keys (set the one matching your provider) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
# Ollama requires no key (local), just set OLLAMA_BASE_URL if non-default
OLLAMA_BASE_URL=http://localhost:11434

# === Graphify Configuration ===
GRAPHIFY_GRAPH_PATH=graphify-out/graph.json
GRAPHIFY_LEARNING_PATH=.graphify_learning.json

# === Execution Configuration ===
TOKEN_BUDGET=100000
MAX_RETRIES=3
STATE_FILE_PATH=state.json
LOG_LEVEL=INFO
